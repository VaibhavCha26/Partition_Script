cat << 'EOF' > Makefile
CC = gcc
CFLAGS = -I. -Wall -Wextra
TARGET = install_script
SOURCES = install_script.c
OBJECTS = $(SOURCES:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) -o $(TARGET) $(OBJECTS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET)

.PHONY: all clean
EOF

